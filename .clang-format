# ==============================================
# Clang-Format 格式化配置文件 .clang-format
# 基础风格：LLVM 官方标准，针对C++项目定制
# 适用场景：嵌入式C++ / Qt / LLVM工具链工程
# 缩进：4空格，禁用Tab，行宽120，左对齐指针，大括号紧跟语句(Attach)
# ==============================================
Language: Cpp
# 继承LLVM基础代码风格
# BasedOnStyle: LLVM

# 访问修饰符(public/private/protected)向左偏移4个空格
AccessModifierOffset: -4

# 多行括号后参数对齐至左括号位置
AlignAfterOpenBracket: Align

# 连续多行宏定义等号垂直对齐
AlignConsecutiveMacros: true
# 连续变量赋值不垂直对齐等号 **
AlignConsecutiveAssignments: false
# 连续变量声明不垂直对齐类型/变量名
AlignConsecutiveDeclarations: false
# 结构体数组初始化字段对齐  **
AlignArrayOfStructures: Left

# 多行字符串换行符右对齐
AlignEscapedNewlines: Right
# 多行二元运算符对齐
AlignOperands: true
# 代码行尾注释统一垂直对齐
AlignTrailingComments: true

# 函数参数全部允许折到下一行
AllowAllArgumentsOnNextLine: true
# 构造函数初始化列表全部允许折到下一行
AllowAllConstructorInitializersOnNextLine: true
# 函数形参列表全部允许折到下一行
AllowAllParametersOfDeclarationOnNextLine: true

# 禁止任何短代码块合并为单行（if/for/while等）
AllowShortBlocksOnASingleLine: Never
# case标签与代码不能放同一行
AllowShortCaseLabelsOnASingleLine: false
# 枚举不能单行压缩
AllowShortEnumsOnASingleLine: false
# 所有函数禁止写成单行
AllowShortFunctionsOnASingleLine: None
# 仅lambda允许压缩单行
AllowShortLambdasOnASingleLine: All
# 短if语句禁止单行
AllowShortIfStatementsOnASingleLine: Never
# 短循环禁止单行
AllowShortLoopsOnASingleLine: false

# 函数定义返回值不强制单独换行
AlwaysBreakAfterDefinitionReturnType: None
# 函数声明返回值不强制单独换行
AlwaysBreakAfterReturnType: None
# 多行字符串开头不强制换行
AlwaysBreakBeforeMultilineStrings: false
# 多行模板声明强制换行
AlwaysBreakTemplateDeclarations: MultiLine

# 同一行尽可能打包多个函数实参 **
BinPackArguments: false
# 同一行尽可能打包多个函数形参
BinPackParameters: true

# 大括号换行规则配置
BraceWrapping:
  # case标签后不单独换行加大括号
  AfterCaseLabel: false
  # class定义末尾不换行加大括号
  AfterClass: false
  # if/for/while等控制语句后不换行加大括号
  AfterControlStatement: false
  # enum定义末尾不换行加大括号
  AfterEnum: false
  # 函数末尾不换行加大括号
  AfterFunction: false
  # namespace末尾不换行加大括号
  AfterNamespace: false
  # OC对象声明不单独换行大括号
  AfterObjCDeclaration: false
  # struct末尾不换行加大括号
  AfterStruct: false
  # union末尾不换行加大括号
  AfterUnion: false
  # extern "C" 块不单独换行大括号
  AfterExternBlock: false
  # catch关键字前不换行
  BeforeCatch: false
  # else关键字前不换行
  BeforeElse: false
  # 大括号内部不额外缩进
  IndentBraces: false
  # 空函数强制拆分两行，禁止 void F() {}
  SplitEmptyFunction: true
  # 空struct/class/enum强制拆分两行
  SplitEmptyRecord: true
  # 空命名空间强制拆分两行
  SplitEmptyNamespace: true

# 二元运算符不在运算符前换行
BreakBeforeBinaryOperators: None
# 大括号紧跟行尾（Attach风格，替代Allman全换行风格）
BreakBeforeBraces: Attach
# BreakBeforeBraces: Allman
# 继承列表逗号前不换行
BreakBeforeInheritanceComma: false
# 继承冒号前换行
BreakInheritanceList: BeforeColon
# 三元运算符在?前换行
BreakBeforeTernaryOperators: true
# 构造初始化列表逗号前不换行
BreakConstructorInitializersBeforeComma: false
# 构造初始化列表冒号后换行
BreakConstructorInitializers: AfterColon

# Java注解相关，C++工程无作用
BreakAfterJavaFieldAnnotations: false
# 超长字符串自动截断换行
BreakStringLiterals: true

# 单行代码最大字符宽度，超出自动换行
ColumnLimit: 120
# 识别IWYU头文件管理注释，不自动格式化删除
CommentPragmas: "^ IWYU pragma:"

# 命名空间不压缩为单行 namespace A { ... }
CompactNamespaces: false
# 构造初始化列表：要么全部一行，要么每个成员单独一行
ConstructorInitializerAllOnOneLineOrOnePerLine: true
# 构造初始化列表缩进宽度
ConstructorInitializerIndentWidth: 4
# 换行后代码延续缩进宽度
ContinuationIndentWidth: 4
# 使用现代C++花括号列表格式化风格
Cpp11BracedListStyle: true

# 自动检测文件换行符LF/CRLF
DeriveLineEnding: true
# 不自动根据代码推导指针对齐方式，强制使用PointerAlignment配置
DerivePointerAlignment: false
# 不关闭格式化功能
DisableFormat: false
# 关闭实验性自动打包参数功能
ExperimentalAutoDetectBinPacking: false
# namespace结束行自动补充 // namespace XXX 注释
FixNamespaceComments: true

# 识别foreach系列循环宏，按for循环格式化
ForEachMacros:
  - foreach
  - Q_FOREACH
  - BOOST_FOREACH

# 保留原有#include空行分组，不打乱分组
IncludeBlocks: Preserve
# 头文件排序优先级：本地项目头 > LLVM头 > 测试第三方头
IncludeCategories:
  - Regex: '^"(llvm|llvm-c|clang|clang-c)/'
    Priority: 2
    SortPriority: 0
  - Regex: '^(<|"(gtest|gmock|isl|json)/)'
    Priority: 3
    SortPriority: 0
  - Regex: ".*"
    Priority: 1
    SortPriority: 0
# 识别单元测试主文件匹配规则
IncludeIsMainRegex: "(Test)?$"
# 主源文件匹配规则留空
IncludeIsMainSourceRegex: ""

# case标签不缩进
IndentCaseLabels: false
# goto标签正常缩进
IndentGotoLabels: true
# 预处理指令(#ifdef/#define等)不缩进
IndentPPDirectives: None
# 基础代码缩进宽度4空格
IndentWidth: 4
# 超长函数名换行后不缩进函数名
IndentWrappedFunctionNames: false
# extern "C" 内部不额外缩进
IndentExternBlock: false

# JS代码引号保持原样，C++无影响
JavaScriptQuotes: Leave
# JS导入自动换行，C++无影响
JavaScriptWrapImports: true

# 代码块起始允许保留空行
KeepEmptyLinesAtTheStartOfBlocks: true
# 宏块起止标记，无特殊宏填空
MacroBlockBegin: ""
MacroBlockEnd: ""
# 文件内最多保留连续1行空行，多余自动删除
MaxEmptyLinesToKeep: 1
# 命名空间内部不缩进
NamespaceIndentation: None

# OC协议列表打包策略，C++无作用
ObjCBinPackProtocolList: Auto
# OC代码块缩进宽度，C++无作用
ObjCBlockIndentWidth: 2
# OC @property后不加空格，C++无作用
ObjCSpaceAfterProperty: false
# OC协议列表前加空格，C++无作用
ObjCSpaceBeforeProtocolList: true

# 换行惩罚值，数值越大越不愿在此处换行
PenaltyBreakAssignment: 2               # 赋值处换行惩罚低，容易换行
PenaltyBreakBeforeFirstCallParameter: 19 # 函数首个参数前换行惩罚
PenaltyBreakComment: 300                 # 注释处尽量不换行
PenaltyBreakFirstLessLess: 120          # <<运算符前尽量不换行
PenaltyBreakString: 1000                 # 字符串禁止随意拆分换行
PenaltyBreakTemplateDeclaration: 10      # 模板声明容易换行
PenaltyExcessCharacter: 1000000         # 超出行宽惩罚极大，强制换行
PenaltyReturnTypeOnItsOwnLine: 60        # 返回值单独换行惩罚

# 指针/引用符号靠左：int* ptr; 而非 int *ptr;
PointerAlignment: Left
# 自动重排多行注释文本
ReflowComments: true
# 自动按规则排序所有#include头文件
SortIncludes: true
# 自动排序using命名空间声明
SortUsingDeclarations: true

# C风格强制转换后不加空格 (int)a → (int) a 禁止
SpaceAfterCStyleCast: false
# !逻辑非后不加空格 !val
SpaceAfterLogicalNot: false
# template关键字后加空格 template <typename T>
SpaceAfterTemplateKeyword: true
# 赋值运算符左右加空格 a = 1
SpaceBeforeAssignmentOperators: true
# C++11花括号列表前不加空格 vec{1,2}
SpaceBeforeCpp11BracedList: false
# 构造初始化冒号前加空格 Foo() : val(0)
SpaceBeforeCtorInitializerColon: true
# 继承冒号前加空格 A : public B
SpaceBeforeInheritanceColon: true
# 仅if/for/while等控制语句括号前加空格，函数调用不加
SpaceBeforeParens: ControlStatements
# 范围for冒号前加空格 for (auto x : list)
SpaceBeforeRangeBasedForLoopColon: true

# 空大括号内部不加空格 {}
SpaceInEmptyBlock: false
# 空括号内部不加空格 func()
SpaceInEmptyParentheses: false
# 行尾注释前保留1个空格
SpacesBeforeTrailingComments: 1

# 尖括号<>内部不加空格 vector<int>
SpacesInAngles: false
# 三元运算符内部不加空格 cond?a:b
SpacesInConditionalStatement: false
# 容器字面量内部加空格 { 1, 2, 3 }
SpacesInContainerLiterals: true
# C风格转换括号内不加空格 (int)a
SpacesInCStyleCastParentheses: false
# 普通括号内部不加空格 func(a,b)
SpacesInParentheses: false
# 方括号[]内部不加空格 arr[0]
SpacesInSquareBrackets: false
# 方括号前不加空格 arr[0]
SpaceBeforeSquareBrackets: false

# 使用最新C++标准格式化规则
Standard: Latest
# 识别Qt特殊宏，不破坏格式
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION

# Tab字符显示宽度8（项目全程不用Tab仅作显示参考）
TabWidth: 8
# 不使用Windows换行CRLF，统一LF
UseCRLF: false
# 全程只用空格，禁用Tab制表符
UseTab: Never
...
